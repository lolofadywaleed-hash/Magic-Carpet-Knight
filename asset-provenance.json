      "roles": [
        {
          "description": "شخصية فارس خيالي ثلاثية الأبعاد تحمل سيفًا وتبقى واضحة من كاميرا خلفية أثناء الطيران والحركة الجانبية والعمودية.",
          "id": "knight-rider",
          "label": "فارس مدرّع راكب"
        },
        {
          "description": "بساط ثلاثي الأبعاد ملوّن ومقروء بصريًا، يتحرك مترابطًا مع فارسك ويُظهر إحساس الطيران دون الاعتماد على شكل بدائي غير مصقول.",
          "id": "magic-carpet",
          "label": "بساط سحري طائر"
        },
        {
          "description": "مجموعة أساسية من الصخور والبوابات والعقبات ثلاثية الأبعاد، ذات ظلال واضحة وأشكال يسهل تمييزها وتفاديها عند ازدياد السرعة.",
          "id": "runner-obstacles",
          "label": "عوائق المسار الخيالية"
        },
        {
          "description": "مقتنيات ثلاثية الأبعاد لامعة وواضحة أثناء الحركة السريعة، مناسبة لإظهار تأثير بسيط عند جمعها واحتساب النقاط.",
          "id": "collectibles",
          "label": "الجواهر والبلورات القابلة للجمع"
        },
        {
          "description": "تكوين ثلاثي الأبعاد ملوّن يوفّر مسارًا جويًا وخلفية عالم متماسكة للفارس والبساط، مع خامات وإضاءة وظلال محسّنة من دون توسيع المشاهد للزينة فقط.",
          "id": "fantasy-course",
          "label": "مسار وعالم الطيران الخيالي"
        }
      ]
    },
