; Magic Carpet Knight – فارس البساط السحري
; Godot 4.7.2 / GL Compatibility
config_version=5

[application]
config/name="Magic Carpet Knight – فارس البساط السحري"
config/description="3D endless runner: fly a knight on a magic carpet, dodge hazards and collect gems."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/share/favicon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.047, 0.145, 1)
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_up={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
pause={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":80)]
}

[environment]
defaults/default_clear_color=Color(0.027, 0.047, 0.145, 1)

[android]
export/architecture="arm64-v8a"
package/unique_name="com.magiccarpetknight.game"
package/name="Magic Carpet Knight"
package/version_code=1
package/version_name="1.0.0"

[gui]
theme/default_font_multichannel_signed_distance_field=true

[editor]
import/use_multiple_threads=false
